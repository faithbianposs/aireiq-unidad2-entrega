      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Temperatura — KPI por ventana de 5 minutos",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "aireiq-postgres"
                      },
                      "spec": {
                        "dataset": "aireiq_operativo",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  $__timeGroupAlias(event_time, '5m'),\r\n  ROUND(AVG(temperatura_c)::numeric, 2) AS \"Promedio °C\",\r\n  ROUND(MIN(temperatura_c)::numeric, 2) AS \"Mínimo °C\",\r\n  ROUND(MAX(temperatura_c)::numeric, 2) AS \"Máximo °C\"\r\nFROM lecturas_aire\r\nWHERE $__timeFilter(event_time)\r\nGROUP BY 1\r\nORDER BY 1;",
