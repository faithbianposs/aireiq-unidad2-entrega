      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Temperatura real vs. predicción a una lectura",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "aireiq-postgres"
                      },
                      "spec": {
                        "dataset": "aireiq_operativo",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH serie AS (\r\n  SELECT\r\n    event_time,\r\n    temperatura_c,\r\n    LAG(temperatura_c) OVER (ORDER BY event_time) AS prediccion_c,\r\n    LAG(event_time) OVER (ORDER BY event_time) AS tiempo_anterior\r\n  FROM lecturas_aire\r\n)\r\nSELECT\r\n  event_time AS \"time\",\r\n  temperatura_c AS \"Temperatura real °C\",\r\n  CASE\r\n    WHEN event_time - tiempo_anterior\r\n         BETWEEN INTERVAL '1 second' AND INTERVAL '90 seconds'\r\n    THEN prediccion_c\r\n  END AS \"Predicción a una lectura °C\"\r\nFROM serie\r\nWHERE $__timeFilter(event_time)\r\nORDER BY event_time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
