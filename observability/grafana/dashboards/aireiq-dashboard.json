      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Latencia Kafka → PostgreSQL (ms)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "aireiq-postgres"
                      },
                      "spec": {
                        "dataset": "aireiq_operativo",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  $__timeGroupAlias(insertado_en, '5m'),\r\n  ROUND(\r\n    AVG(EXTRACT(EPOCH FROM (insertado_en - kafka_timestamp)) * 1000)::numeric,\r\n    1\r\n  ) AS \"Latencia media (ms)\"\r\nFROM lecturas_aire\r\nWHERE $__timeFilter(insertado_en)\r\n  AND insertado_en >= NOW() - INTERVAL '30 minutes'\r\nGROUP BY 1\r\nORDER BY 1;",
